+//------------------------------------------------------------------------------
+// UP Path Change (TS 29.508 SmfEvent = UP_PATH_CH).
+//
+// Modelled on handle_ue_ip_change() above; the only differences are the event
+// enum and the two DNAI fields.
+//
+// WHY: TS 23.288 clause 6.14.2 routes DN Performance analytics' SMF-side input
+// through Table 6.4.2-2, which lists DNAI and UPF info as SMF-sourced. Without
+// this notification an NWDAF cannot know which DNAI a PDU session's traffic is
+// flowing over, so it cannot attribute a usage report to a DNAI, and
+// DN_PERFORMANCE - whose whole output is per-DNAI (Table 6.14.3-1) - is not
+// computable.
+//
+// The SMF could already PARSE an UP_PATH_CH subscription
+// (smf_3gpp_conversions.cpp) but never notified one.
+// CLASSIFICATION: OAI implementation gap.
+//
+// NOT emitted, deliberately:
+//  - upfInfo:      process_upf_profile() keeps only host and UpfInfo and
+//                  discards getNfInstanceId(), so this SMF does not hold the
+//                  UPF's NF Instance ID. The NWDAF resolves it from the NRF.
+//  - dnaiChgType:  EARLY / LATE / EARLY_LATE (TS 23.502 clause 4.3.6.3). This
+//                  SMF has no early-notification path, so reporting a change
+//                  type would be inventing one.
+//  - sourceTraRouting / targetTraRouting: the SMF does not model a
+//                  RouteToLocation for the session.
+// Absent, never faked.
+void smf_context::handle_up_path_change(
+    const scid_t& scid, const std::string& source_dnai,
+    const std::string& target_dnai, const uint8_t& http_version) const {
+  // A notification with no target DNAI carries no information: the whole point
+  // of the event is to say which DNAI the session is now on.
+  if (target_dnai.empty()) {
+    Logger::smf_app().debug(
+        "UP Path Change (Event Exposure): no target DNAI for "
+        "SMF Context ID " SCID_FMT ", nothing to notify",
+        scid);
+    return;
+  }
+
+  std::string supi                    = {};
+  std::shared_ptr<smf_pdu_session> sp = {};
+  if (!get_pdu_session_info(scid, supi, sp)) {
+    Logger::smf_app().debug(
+        "Could not retrieve info with "
+        "SMF Context ID " SCID_FMT " ",
+        scid);
+    return;
+  }
+
+  Logger::smf_app().debug(
+      "Send request to N11 to trigger UP Path Change (Event Exposure), "
+      "SUPI %s, PDU Session ID %u, source DNAI '%s', target DNAI '%s', "
+      "HTTP version %u",
+      supi.c_str(), sp->get_pdu_session_id(), source_dnai.c_str(),
+      target_dnai.c_str(), http_version);
+
+  std::vector<std::shared_ptr<smf_subscription>> subscriptions = {};
+  smf_app_inst->get_ee_subscriptions(
+      smf_event_t::SMF_EVENT_UP_PATH_CH, subscriptions);
+
+  if (subscriptions.size() > 0) {
+    Logger::smf_app().debug(
+        "Send ITTI msg to SMF N11 to trigger the event notification");
+    std::shared_ptr<itti_sbi_notify_subscribed_event> itti_msg =
+        std::make_shared<itti_sbi_notify_subscribed_event>(
+            TASK_SMF_APP, TASK_SMF_SBI);
+
+    for (auto i : subscriptions) {
+      event_notification ev_notif = {};
+      ev_notif.set_supi(supi);                                // SUPI
+      ev_notif.set_pdu_session_id(sp->get_pdu_session_id());  // PDU session ID
+      ev_notif.set_smf_event(smf_event_t::SMF_EVENT_UP_PATH_CH);
+      ev_notif.set_notif_uri(i.get()->notif_uri);
+      ev_notif.set_notif_id(i.get()->notif_id);
+      // timestamp
+      std::time_t time_epoch_ntp = std::time(nullptr);
+      uint64_t tv_ntp            = time_epoch_ntp + SECONDS_SINCE_FIRST_EPOCH;
+      ev_notif.set_timestamp(std::to_string(tv_ntp));
+
+      // TS 29.508: sourceDnai is conditional. It is genuinely absent for the
+      // first notification of a session, so it is left unset rather than sent
+      // as an empty string.
+      if (!source_dnai.empty()) {
+        ev_notif.set_source_dnai(source_dnai);
+      }
+      ev_notif.set_target_dnai(target_dnai);
+
+      itti_msg->event_notifs.push_back(ev_notif);
+    }
+
+    itti_msg->http_version = http_version;
+
+    int ret = itti_inst->send_msg(itti_msg);
+    if (RETURNok != ret) {
+      Logger::smf_app().error(
+          "Could not send ITTI message %s to task TASK_SMF_SBI",
+          itti_msg->get_msg_name());
+    }
+  } else {
+    Logger::smf_app().debug("No subscription available for this event");
+  }
+}
