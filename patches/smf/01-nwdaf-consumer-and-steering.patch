+void smf_context::trigger_up_path_change(
+    const scid_t& scid, const std::string& source_dnai,
+    const std::string& target_dnai, const uint8_t& http_version) const {
+  event_sub.ee_up_path_change(scid, source_dnai, target_dnai, http_version);
+}
