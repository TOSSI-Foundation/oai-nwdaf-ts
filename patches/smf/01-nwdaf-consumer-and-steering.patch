+  // (b) made the self-trigger's "am I already there?" damping check useless,
+  // so it re-asked for a DNAI the session was already on, forever.
+  for (const auto& [node, edges] : adjacency_list) {
+    for (const auto& edge : edges) {
+      if (!edge || edge->type != n6_type || edge->nw_instance.empty()) continue;
+      std::shared_ptr<pfcp_association> upf =
+          edge->source_upf ? edge->source_upf : edge->destination_upf;
+      if (!upf) continue;
+      const oai::config::smf::upf cfg = upf->get_upf_config();
+      for (const auto& snssai : cfg.get_upf_info().getSNssaiUpfInfoList()) {
+        for (const auto& dnn : snssai.getDnnUpfInfoList()) {
+          for (const auto& [dnai, nwi] : dnn.getDnaiNwInstanceList()) {
+            if (nwi == edge->nw_instance) return dnai;
+          }
+        }
+      }
+    }
+  }
+
+  // Genuinely nothing to report: no N6 edge, or an instance the UPF does not
+  // advertise a DNAI for. Absent, never invented.
+  return {};
+}
+
+//---------------------------------------------------------------------------------------------
+// Shared by get_n6_dnai() and get_n6_confirmed_dnai(): resolve a DNAI for an N6
+// edge, preferring the DNAI recorded on it and otherwise reverse-mapping its
+// network instance through the UpfInfo dnaiNwInstanceList.
+static std::string dnai_of_n6_edge(
+    const std::shared_ptr<qos_upf_edge>& edge, const std::string& dnai_field,
+    const std::string& nwi_field) {
+  if (!dnai_field.empty()) return dnai_field;
+  if (nwi_field.empty()) return {};
+  std::shared_ptr<pfcp_association> upf =
+      edge->source_upf ? edge->source_upf : edge->destination_upf;
+  if (!upf) return {};
+  const oai::config::smf::upf cfg = upf->get_upf_config();
+  for (const auto& snssai : cfg.get_upf_info().getSNssaiUpfInfoList()) {
+    for (const auto& dnn : snssai.getDnnUpfInfoList()) {
+      for (const auto& [dnai, nwi] : dnn.getDnaiNwInstanceList()) {
+        if (nwi == nwi_field) return dnai;
+      }
+    }
+  }
+  return {};
+}
+
+//---------------------------------------------------------------------------------------------
+std::string upf_graph::get_n6_confirmed_dnai() const {
+  std::shared_lock graph_lock(graph_mutex);
+
+  UPInterfaceType n6_type;
+  n6_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N6);
+
+  for (const auto& [node, edges] : adjacency_list) {
+    for (const auto& edge : edges) {
+      if (!edge || edge->type != n6_type) continue;
+      const std::string d = dnai_of_n6_edge(
+          edge, edge->confirmed_dnai, edge->confirmed_nw_instance);
+      if (!d.empty()) return d;
+    }
+  }
+  // The UPF has acknowledged nothing for this session yet. Empty means
+  // "unknown", never "none".
+  return {};
+}
+
+//---------------------------------------------------------------------------------------------
+std::string upf_graph::confirm_n6_state() {
+  std::unique_lock graph_lock(graph_mutex);
+
+  UPInterfaceType n6_type;
+  n6_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N6);
+
+  std::string confirmed = {};
+  for (auto& node : adjacency_list) {
+    for (auto& edge : node.second) {
+      if (!edge || edge->type != n6_type) continue;
+      edge->confirmed_nw_instance = edge->nw_instance;
+      edge->confirmed_dnai        = edge->used_dnai;
+      if (confirmed.empty()) {
+        confirmed = dnai_of_n6_edge(
+            edge, edge->confirmed_dnai, edge->confirmed_nw_instance);
+      }
+    }
+  }
+  return confirmed;
+}
+
+//---------------------------------------------------------------------------------------------
+bool upf_graph::rollback_unconfirmed_n6_state() {
+  std::unique_lock graph_lock(graph_mutex);
+
+  UPInterfaceType n6_type;
+  n6_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N6);
+
+  bool rolled_back = false;
+  for (auto& node : adjacency_list) {
+    for (auto& edge : node.second) {
+      if (!edge || edge->type != n6_type) continue;
+      // Nothing acknowledged yet: there is no earlier state to restore, and
+      // blanking the instance would leave the edge unusable.
+      if (edge->confirmed_nw_instance.empty()) continue;
+      if (edge->nw_instance == edge->confirmed_nw_instance &&
+          edge->used_dnai == edge->confirmed_dnai) {
+        continue;
+      }
+      Logger::smf_app().warn(
+          "Steering rollback: N6 edge intent '%s' was never acknowledged by the "
+          "UPF; restoring the confirmed instance '%s'",
+          edge->nw_instance.c_str(), edge->confirmed_nw_instance.c_str());
+      edge->nw_instance         = edge->confirmed_nw_instance;
+      edge->used_dnai           = edge->confirmed_dnai;
+      edge->n4_update_necessary = false;
+      rolled_back               = true;
+    }
+  }
+  return rolled_back;
+}
+
+//---------------------------------------------------------------------------------------------
+bool upf_graph::apply_steering_dnai(const std::string& dnai) {
+  std::unique_lock graph_lock(graph_mutex);
+  bool changed = false;
+
+  UPInterfaceType n6_type;
+  n6_type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N6);
+
+  for (auto& node : adjacency_list) {
+    for (auto& edge : node.second) {
+      if (!edge || edge->type != n6_type) continue;
+
+      // The UPF that owns this N6 interface: for an N6 edge the association is
+      // reachable through either endpoint depending on direction.
+      std::shared_ptr<pfcp_association> upf =
+          edge->source_upf ? edge->source_upf : edge->destination_upf;
+      if (!upf) continue;
+
+      // Same lookup as qos_upf_edge::associate_dnai(): UpfInfo advertises a
+      // dnaiNwInstanceList per DNN, mapping DNAI -> network instance.
+      const oai::config::smf::upf cfg = upf->get_upf_config();
+      for (const auto& snssai : cfg.get_upf_info().getSNssaiUpfInfoList()) {
+        for (const auto& dnn : snssai.getDnnUpfInfoList()) {
+          const auto& instances = dnn.getDnaiNwInstanceList();
+          const auto find       = instances.find(dnai);
+          if (find == instances.end()) continue;
+          if (find->second.empty() || find->second == edge->nw_instance) continue;
+
+          // The DNAI list of a DNN also contains the access-side DNAI, which
+          // maps to the N3 network instance. Only accept a candidate that the
+          // UPF actually advertises on an N6 interface, otherwise a steering
+          // decision could bind an N6 edge to the access instance.
+          bool is_n6 = false;
+          for (const auto& iface :
+               cfg.get_upf_info().getInterfaceUpfInfoList()) {
+            if (iface.getInterfaceType() == n6_type &&
+                iface.getNetworkInstance() == find->second) {
+              is_n6 = true;
+              break;
+            }
+          }
+          if (!is_n6) {
+            Logger::smf_app().debug(
+                "Steering: ignoring DNAI '%s' -> '%s' (not an N6 instance)",
+                dnai.c_str(), find->second.c_str());
+            continue;
+          }
+
+          Logger::smf_app().info(
+              "Steering: DNAI '%s' -> network instance '%s' (was '%s')",
+              dnai.c_str(), find->second.c_str(), edge->nw_instance.c_str());
+          edge->nw_instance         = find->second;
+          edge->used_dnai           = dnai;
+          edge->n4_update_necessary = true;
+          changed                   = true;
+        }
+      }
+    }
+  }
+
+  if (!changed) {
+    Logger::smf_app().warn(
+        "Steering: DNAI '%s' did not resolve to a new network instance on any "
+        "N6 edge of this session",
+        dnai.c_str());
+  }
+  return changed;
+}
