diff --git a/docker-compose/policies/steering/pcc_rules/pcc_rules.yaml b/docker-compose/policies/steering/pcc_rules/pcc_rules.yaml
index 36b3753..d3607c1 100644
--- a/docker-compose/policies/steering/pcc_rules/pcc_rules.yaml
+++ b/docker-compose/policies/steering/pcc_rules/pcc_rules.yaml
@@ -10,4 +10,13 @@ steering-rule-secondary:
     - flowDescription: permit out ip from any to assigned
   precedence: 10
   refTcData:
-    - steering-scenario-secondary
\ No newline at end of file
+    - steering-scenario-secondary
+
+# Provisioned steering rule authorizing both N6 DNAIs. Precedence stays 10 so an
+# AF-installed rule (precedence 1) still out-ranks it, preserving Route 2.
+steering-rule-both:
+  flowInfos:
+    - flowDescription: permit out ip from any to assigned
+  precedence: 10
+  refTcData:
+    - steering-scenario-both
diff --git a/docker-compose/policies/steering/policy_decisions/policy_decision.yaml b/docker-compose/policies/steering/policy_decisions/policy_decision.yaml
index bef83e6..e0762d7 100644
--- a/docker-compose/policies/steering/policy_decisions/policy_decision.yaml
+++ b/docker-compose/policies/steering/policy_decisions/policy_decision.yaml
@@ -1,7 +1,10 @@
 decision_supi1:
   supi_imsi: "208950000000032"
   pcc_rules: 
-    - steering-rule-primary
+    # Both N6 DNAIs authorized so the SMF NWDAF consumer has a real choice to
+    # make. Was steering-rule-primary, which authorized internet-primary only -
+    # the SMF could then never legally select internet-secondary.
+    - steering-rule-both
 
 decision_supi2:
   supi_imsi: "208950000000033"
diff --git a/docker-compose/policies/steering/traffic_rules/traffic_rule.yaml b/docker-compose/policies/steering/traffic_rules/traffic_rule.yaml
index 43a4661..c74f354 100644
--- a/docker-compose/policies/steering/traffic_rules/traffic_rule.yaml
+++ b/docker-compose/policies/steering/traffic_rules/traffic_rule.yaml
@@ -7,3 +7,16 @@ steering-scenario-secondary:
   routeToLocs:
     - dnai: access
     - dnai: internet-secondary
+
+# Authorizes BOTH N6 DNAIs for one session so the SMF may (re)select between
+# them. TS 23.503 clause 6 ("AF influenced Traffic Steering Enforcement
+# Control"): a PCC rule carries "a set of DNAI(s) (i.e. a reference to the
+# DNAI(s) the SMF needs to consider for UPF selection/reselection)".
+# 'access' is kept because it is the N3/access-side DNAI of the same DNN; the
+# SMF's apply_steering_dnai() ignores any DNAI that does not resolve to an N6
+# network instance, so listing it here is safe.
+steering-scenario-both:
+  routeToLocs:
+    - dnai: access
+    - dnai: internet-primary
+    - dnai: internet-secondary
