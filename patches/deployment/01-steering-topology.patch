# Deployment: two N6 DNAIs, PCF steering policies, SMF NWDAA env
#
# Upstream : https://gitlab.eurecom.fr/oai/cn5g/oai-cn5g-fed.git
# Base     : 55859262fbcdaf6c89d8ccf9caed70ef432e4cb3
# Apply    : git checkout 55859262fbcdaf6c89d8ccf9caed70ef432e4cb3 && git apply <this file>
#
# Adds the second N6 interface/DNAI to the VPP-UPF, the PCF steering policy set,
# and the SMF_NWDAF_* environment that enables the consumer.
#
diff --git a/docker-compose/conf/basic_vpp_nrf_config.yaml b/docker-compose/conf/basic_vpp_nrf_config.yaml
index 5658a48..51adbea 100644
--- a/docker-compose/conf/basic_vpp_nrf_config.yaml
+++ b/docker-compose/conf/basic_vpp_nrf_config.yaml
@@ -86,6 +86,12 @@ nfs:
       port: 8080
       api_version: v1
       interface_name: eth0
+  pcf:
+    host: oai-pcf
+    sbi:
+      port: 8080
+      api_version: v1
+      interface_name: eth0
 
 #### Common for UDR and AMF
 database:
@@ -202,6 +208,12 @@ smf:
         session_ambr_ul: "50Mbps"
         session_ambr_dl: "100Mbps"
 
+pcf:
+  local_policy:
+    policy_decisions_path: /openair-pcf/policies/policy_decisions
+    pcc_rules_path: /openair-pcf/policies/pcc_rules
+    traffic_rules_path: /openair-pcf/policies/traffic_rules
+
 ## DNN configuration
 dnns:
   - dnn: "oai"
diff --git a/docker-compose/conf/ulcl_config.yaml b/docker-compose/conf/ulcl_config.yaml
index 926e836..dd154b2 100644
--- a/docker-compose/conf/ulcl_config.yaml
+++ b/docker-compose/conf/ulcl_config.yaml
@@ -113,7 +113,7 @@ snssais:
     sd: 000001 # in hex
   - &custom_slice
     sst: 222
-    sd: 00007B # in hex
+    sd: 000005 # in hex
 
 ############# NF-specific configuration
 amf:
@@ -163,6 +163,15 @@ smf:
     use_local_pcc_rules: no # Use infos from local_pcc_rules or from PCF
   # this is an example how you can enable/disable UPF features while the profile comes from NRF, host has to match with NRF profile
   upfs:
+    # NWDAF closed loop: the traffic-steering engine's features come from PFCP
+    # usage reports (smf.qosmonlist via oai-nwdaf-sbi). A UPF discovered from the
+    # NRF whose host is absent from this list gets the default
+    # enable_usage_reporting = false, so no URRs were installed and every feature
+    # read zero. This deployment's UPF registers as vpp-upf.node...., not
+    # ulcl.node...., which is why it needed an entry of its own.
+    - host: vpp-upf.node.5gcn.mnc95.mcc208.3gppnetwork.org
+      config:
+        enable_usage_reporting: yes
     - host: ulcl.node.5gcn.mnc95.mcc208.3gppnetwork.org
       config:
         enable_usage_reporting: yes
diff --git a/docker-compose/docker-compose-basic-vpp-nrf.yaml b/docker-compose/docker-compose-basic-vpp-nrf.yaml
