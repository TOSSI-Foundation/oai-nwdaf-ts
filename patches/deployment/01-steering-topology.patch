@@ -100,7 +100,7 @@ services:
                 ipv4_address: 192.168.70.132
     oai-smf:
         container_name: "oai-smf"
-        image: oaisoftwarealliance/oai-smf:v2.0.0
+        image: oai-smf:nwdaf-policy
         expose:
             - 80/tcp
             - 8080/tcp
@@ -109,6 +109,17 @@ services:
             - ./conf/ulcl_config.yaml:/openair-smf/etc/config.yaml
         environment:
             - TZ=Europe/Paris
+            # TS 23.288 clause 6.4.4/6.14: the SMF is the NF that (re)selects the
+            # UP path (UPF and DNAI) from NWDAF analytics. Off unless enabled.
+            - SMF_NWDAF_ENABLE=1
+            # clause 6.5.1 Analytics Filter Information: the UPF's NF Instance ID,
+            # as registered in the NRF.
+            - SMF_NWDAF_TARGET_UPF_NF_INSTANCE_ID=4f4f850a-552e-4a60-9d31-a108271e3daf
+            - SMF_NWDAF_POLL_SEC=10
+            - SMF_NWDAF_LOAD_THRESHOLD=50
+            - SMF_NWDAF_CLEAR_STREAK=2
+            - SMF_NWDAF_DNAI_NORMAL=internet-primary
+            - SMF_NWDAF_DNAI_CONGESTED=internet-secondary
         extra_hosts:
             - "vpp-upf.node.5gcn.mnc95.mcc208.3gppnetwork.org:192.168.70.201"
         depends_on:
@@ -118,7 +129,7 @@ services:
                 ipv4_address: 192.168.70.133
     oai-pcf:
         container_name: "oai-pcf"
-        image: oaisoftwarealliance/oai-pcf:v2.0.0
+        image: oai-pcf:route2
         expose:
             - 80/tcp
             - 8080/tcp
@@ -161,7 +172,7 @@ services:
             - VPP_CORE_WORKER=1
 #           - VPP_PLUGIN_PATH=/usr/lib64/vpp_plugins/                # RHEL7
             - VPP_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/vpp_plugins/ # Ubntu18.04
-            - SNSSAI_SD=123
+            - SNSSAI_SD=5
             - SNSSAI_SST=222
             - DNN=default
             - REGISTER_NRF=yes
