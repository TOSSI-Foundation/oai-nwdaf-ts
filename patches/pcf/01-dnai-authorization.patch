+// Highest priority, so an AF routing request wins over provisioned rules.
+static constexpr int32_t AF_ROUTING_RULE_PRECEDENCE = 1;
+
 //------------------------------------------------------------------------------
 pcf_policy_authorization::pcf_policy_authorization(pcf_event& ev)
     : m_event_sub(ev) {}
 
+//------------------------------------------------------------------------------
+// Route 2: translate an AF routing requirement (TS 23.503 "AF influence on
+// traffic routing", TS 29.514 AppSessionContextReqData.afRoutReq) into the
+// SmPolicyDecision fields the SMF consumes.
+//
+// Previously request_decision was declared and never populated, so the AF path
+// merged an empty decision and the resulting UpdateNotify carried the unchanged
+// policy. This builds a TrafficControlData holding the AF's routeToLocs and a
+// PCC rule referencing it, so a steering change made by an AF actually reaches
+// the SMF.
+// Takes the routeToLocs vector rather than the requirement object: the create
+// path yields AfRoutingRequirement while the update path yields
+// AfRoutingRequirementRm (distinct generated types), but both expose
+// getRouteToLocs()/routeToLocsIsSet() with the same element type.
+static void af_routing_to_decision(
+    const std::vector<oai::_3gpp::model::RouteToLocation>& route_to_locs,
+    const std::string& tc_id, const std::string& rule_id,
+    oai::_3gpp::model::SmPolicyDecision& request_decision) {
+  if (route_to_locs.empty()) {
+    return;
+  }
+
+  oai::_3gpp::model::TrafficControlData tc_data = {};
+  tc_data.setTcId(tc_id);
+  tc_data.setRouteToLocs(route_to_locs);
+
+  std::map<std::string, oai::_3gpp::model::TrafficControlData> tcs = {};
+  tcs.insert(std::make_pair(tc_id, tc_data));
+  request_decision.setTraffContDecs(tcs);
+
+  oai::_3gpp::model::PccRule rule = {};
+  rule.setPccRuleId(rule_id);
+  rule.setRefTcData(std::vector<std::string>{tc_id});
+  // TS 29.512: lower precedence value = higher priority. An explicit AF
+  // routing requirement must override any pre-provisioned steering rule,
+  // otherwise validate_and_merge_decision() assigns highest+1 and the stale
+  // rule keeps winning at the SMF.
+  rule.setPrecedence(AF_ROUTING_RULE_PRECEDENCE);
+
+  std::map<std::string, oai::_3gpp::model::PccRule> rules = {};
+  rules.insert(std::make_pair(rule_id, rule));
+  request_decision.setPccRules(rules);
+
+  std::string dnais = {};
+  for (const auto& r : route_to_locs) dnais += r.getDnai() + " ";
+  Logger::pcf_app().info(
+      "AF routing requirement -> TrafficControlData '%s' (DNAIs: %s)",
+      tc_id.c_str(), dnais.c_str());
+}
+
