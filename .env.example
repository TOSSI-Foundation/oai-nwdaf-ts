# Copy to .env and adjust. Every value below is the shipping default.

# ── SMF NWDAF consumer ────────────────────────────────────────────────────────
SMF_NWDAF_ENABLE=1                  # off unless set; the feature is opt-in
SMF_NWDAF_ANALYTICS_ID=DN_PERFORMANCE   # NF_LOAD | DN_PERFORMANCE
SMF_NWDAF_ACT=1                     # 0 = decide and log only, never actuate
SMF_NWDAF_POLL_SEC=10
SMF_NWDAF_PREDICT_SEC=60            # TS 29.520 offsetPeriod; 0 = statistics only
SMF_NWDAF_MIN_CONFIDENCE=50         # predictions below this are ignored
SMF_NWDAF_DNPERF_MARGIN_PERCENT=10  # hysteresis before changing preference

# ── NWDAF engine ──────────────────────────────────────────────────────────────
ENGINE_DN_PERFORMANCE_WINDOW_SEC=300        # analytics AVERAGING window
ENGINE_DN_PERFORMANCE_HEALTH_MAX_AGE_SEC=30 # path-health FRESHNESS bound (≠ above)

# ── Telemetry collector ───────────────────────────────────────────────────────
PATH_HEALTH_MIN_ATTEMPTS=1000       # below this → UNKNOWN_INSUFFICIENT_SAMPLES
                                    # 0 disables the floor. Raise, never lower.
UPF_VPP_COUNTERS=1                  # 0 disables per-DNAI interface telemetry
VPP_CTL=/openair-upf/bin/vppctl     # NOT on $PATH inside the container
POLL_INTERVAL_SEC=5
MONGODB_URI=mongodb://localhost:27017
